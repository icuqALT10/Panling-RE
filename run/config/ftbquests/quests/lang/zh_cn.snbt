	quest.01BACC2F6FD6F306.quest_desc: [
		"&a生命值&r："
		"范围：( 0 , 1000000 ]"
		""
		"&a护甲值&r："
		"&e现在护甲值对绝大部分伤害类型都有效&r"
		"范围：[ -1000000 , 1000000 ]"
		"&a护甲值&r >= &60&r时"
		"&4最终伤害&r = &c伤害值&rx(&6100&r/(&6100&r+&a护甲值&r))"
		"&a护甲值&r < &60&r时"
		"&4最终伤害&r = (&c伤害值&rx(&62&r-(&6100&r/(&6100&r-&a护甲值&r)))"
		"{@pagebreak}"
		"&a最大灵气值&r："
		"&e玩家的蓝量&r"
		"范围为：[ 0 , 100000000 ]"
		""
		"&a灵气恢复&r："
		"&e每秒恢复灵气速率&r"
		"范围为：[ -100% , 100% ]"
		"灵气值每秒根据&b上限&r恢复的速率"
		""
		"{image:panlingre:textures/gui/hud/falizhi.png width:20 height:20 align:center}"
		"&a法力值&r(位于血条上方、护甲值右方)："
		"&e主要用于某些装备中&r"
		"范围：[ 0 , 9999.99 ]"
		"{@pagebreak}"
		"&a冷却缩减&r："
		"&e触发大部分冷却时的减免区间&r"
		"范围：[ -10000% , 100% ]"
		"&4最终冷却&r = &c冷却时间&rx(&61&r-&a冷却缩减&r)"
		""
		"&a箭矢强度&r："
		"&e弓箭手专属属性，用于提高箭矢的伤害&r"
		"&7(部分远程生物也具有该属性)&r"
		"范围：[ 0 , 100000000 ]"
		""
		"&a炼化强度&r："
		"&e炼丹师专属属性，用于提升丹药等物品的效果&r"
		"范围：[ 0 , 100000000 ]"
	]
